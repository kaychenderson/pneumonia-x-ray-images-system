# Copie para .env e ajuste. Nunca versionar o .env real.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ADMIN_URL=admin/
# Em produção (DEBUG=False): HTTPS obrigatório por padrão
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_PROXY=False          # True se estiver atrás de nginx/ELB com X-Forwarded-Proto
DJANGO_HSTS_SECONDS=0              # ex.: 31536000 após validar o HTTPS
TRUST_X_FORWARDED_FOR=False        # True só se o proxy sobrescreve o X-Forwarded-For

# --- Banco (padrão: SQLite local) ---
# DATABASE_URL=postgres://pneumoai:senha@localhost:5432/pneumoai

# --- Front-end / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Autenticação ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_HOURS=12
PASSWORD_RESET_TIMEOUT_SECONDS=86400
# True: novos cadastros ficam inativos até um administrador aprovar
REGISTRATION_REQUIRES_APPROVAL=True

# --- E-mail (recuperação de senha / convites) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PneumoAI <nao-responda@pneumoai.com.br>
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Arquivos ---
# MEDIA_ROOT=/var/lib/pneumoai/media
MAX_XRAY_UPLOAD_MB=15
MAX_AVATAR_UPLOAD_MB=5

# --- Modelo de IA ---
MODEL_PATH=ml_models/modelDenseNet121_Pneumonia.keras
# MODEL_VERSION=densenet121-v1        # vazio = nome do arquivo + hash SHA-256
MODEL_CLASS_NAMES=NORMAL,PNEUMONIA    # ordem alfabética = ordem do image_dataset_from_directory
MODEL_THRESHOLD=0.5
MODEL_LOW_CONFIDENCE=0.70             # confiança abaixo disso marca low_confidence=true
ANALYZE_ON_CREATE=True                # analisa automaticamente ao registrar o exame

# --- Opcional ---
# REDIS_URL=redis://localhost:6379/1
# ENABLE_API_DOCS=True                # Swagger em /api/docs/ (padrão: só com DEBUG)
# LOG_LEVEL=INFO
